APP_NAME=SaudeMaxi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Apenas para revisao local; nunca habilita demonstracao em production.
HEALTHCARE_DEMO_ENABLED=false

# Liga/desliga o login via API externa da lsxmedical.
# false (padrao): login autentica pelo banco de dados local (Auth::attempt).
# true: login autentica contra a API da lsxmedical usando o token de servico abaixo.
LSXMEDICAL_LOGIN_ENABLED=false

# Base da API do provedor de telemedicina (lsxmedical). O valor abaixo e o
# ambiente de homologacao; troque para a URL de producao antes de publicar.
LSXMEDICAL_BASE_URL=https://homolog2.lsxmedical.com

# Token de servico da clinica (Bearer), usado em todos os endpoints /api/clinic/*
# (login, busca e cadastro de pacientes, agendamento etc.).
TELEMEDICINE_API_TOKEN=

LSXMEDICAL_LOGIN_ENDPOINT=/api/clinic/patients/authenticate
LSXMEDICAL_FILTER_PATIENTS_ENDPOINT=/api/clinic/filter-patients/
LSXMEDICAL_CREATE_PATIENT_ENDPOINT=/api/clinic/create-patient/
LSXMEDICAL_TIMEOUT=10
